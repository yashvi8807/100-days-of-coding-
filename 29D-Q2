//Q58: Find the maximum and minimum element in an array.
#include<stdio.h>
int main()
{
    int n;
    printf("Enter the no. of elements.");
    scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    int Max=arr[0];
    for(int i=0;i<n;i++){
        if(arr[i]>Max){
            Max=arr[i];
        }
        else {
            continue;
        }}
    printf("Max=%d\n",Max);
    int Min=arr[0];
    for(int i=0;i<n;i++){
        if(arr[i]<Min){
            Min=arr[i];
        }
        else {
            continue;
        }
    }
    printf("Min=%d\n",Min);
    return 0;
}  
