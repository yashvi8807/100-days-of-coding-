//Q59: Count even and odd numbers in an array.
#include<stdio.h>
int main()
{
    int n;
    printf("Enter the no. of elements.");
    scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    int even=0;
    for(int i=0;i<n;i++){
        if(arr[i] % 2 == 0){
            even++;
        }
        else {
            continue;
        }
    }
    printf("Even=%d ",even);
    int odd=0;
    for(int i=0;i<n;i++){
        if(arr[i] % 2 != 0){
            odd++;
        }
        else {
            continue;
        }
    }
    printf("Odd=%d\n",odd);
    return 0;
}
