//Q60: Count positive, negative, and zero elements in an array.
#include<stdio.h>
int main()
{
    int n;
    printf("Enter the no. of elements.");
    scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    int positive=0;
    for(int i=0;i<n;i++){
        if(arr[i]>0){
            positive++;
        }
        else {
            continue;
        }
    }
    printf("Positive=%d ",positive);
    int neg=0;
    for(int i=0;i<n;i++){
        if(arr[i]<0){
            neg++;
        }
        else {
            continue;
        }
    }
    printf("Negative=%d ",neg);
    int zero=0;
    for(int i=0;i<n;i++){
        if(arr[i]==0){
            zero++;
        }
        else {
            continue;
        }
    }
    printf("Zero=%D",zero);
    return 0;
}
