//Q61: Search for an element in an array using linear search.
#include<stdio.h>
int main()
{
    int n;
    printf("Enter the no. of elements.");
    scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    int c=0;
    int x;
    printf("Enter the no. you want to search.");
    scanf("%d",&x);
    for(int i=0;i<n;i++){
        if(arr[i] == x){
            printf("Found at index %d\n",i);
        }
        else {
            c++;
        }

    }
    if (c!=1)
    {
        printf("-1\n");
    }
    return 0;
}
