//Q63: Merge two arrays.
#include<stdio.h>
int main()
{
    int n1,n2;
    printf("Enter the no. of elements of arr1: ");
    scanf("%d",&n1);

    int arr1[n1];
    printf("Enter elements:");
    for(int i=0;i<n1;i++){
        scanf("%d",&arr1[i]);
    }
    printf("Enter the no. of elements of arr2: ");
    scanf("%d",&n2);

    int arr2[n2];
    printf("Enter elements:");
    for(int j=0;j<n2;j++){
        scanf("%d",&arr2[j]);
    }
    int n3;
    n3=n1+n2;
    int arr3[n3];
    for(int k=0;k<n1;k++){
        arr3[k]=arr1[k];
    }
    for(int l=0;l<n2;l++){
        arr3[l+n1]=arr2[l];
    }
    for(int m=0;m<n3;m++){
        printf("%d ",arr3[m]);
    }
    return 0;
}
