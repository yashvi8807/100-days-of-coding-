//Q66: Insert an element in a sorted array at the appropriate position.

#include <stdio.h>
int main()
{
    int n;
    printf("Enter the size of array.");
    scanf("%d", &n);
    int arr[n + 1]; 
    printf("Enter elements of array:");
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    int x;
    printf("Enter the number that is to be inserted.");
    scanf("%d", &x);
    int i = n - 1;
    while (i >= 0 && arr[i] > x) {
        arr[i + 1] = arr[i];
        i--;
    }
    arr[i+1]=x;
    n++;
    for (int j = 0; j < n; j++) {
        printf("%d ", arr[j]);
    }
    return 0;
}
