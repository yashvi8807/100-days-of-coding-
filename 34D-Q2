//Q68: Delete an element from an array.
#include <stdio.h>
int main() {
    int n;
    printf("Enter the size of array.");
    scanf("%d", &n);
    int arr[n];
    printf("Enter elements of array:");
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    int p;
    printf("Enter the position of the element which is to be deleted.");
    scanf("%d", &p); 
    for (int i = p; i < n - 1; i++) {
        arr[i] = arr[i + 1];
    }
    n--; 
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    return 0;
}
