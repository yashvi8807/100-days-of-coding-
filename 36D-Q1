//Q71: Read and print a matrix.
#include<stdio.h>
int main()
{
    int n,m;
    printf("Enter size of matrix n,m:");
    scanf("%d %d",&n,&m);
    int a[n][m];
    printf("Enter the elements of array.");
    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
    scanf("%d",&a[i][j]);
        }
    }
    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
    printf("%d ",a[i][j]);
        }
        printf("\n");
    }
    return 0;
}
