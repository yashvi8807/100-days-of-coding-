//Q73: Find the sum of each row of a matrix and store it in an array.
#include <stdio.h>
int main() {
    int n, m;
    printf("Enter size of matrix n,m:");
    scanf("%d %d", &n, &m);
    int a[n][m];
    int sum[n];
    printf("Enter elements of matrix.");
    for(int i = 0; i < n; i++) {
        sum[i] = 0;
        for(int j = 0; j < m; j++) {
            scanf("%d", &a[i][j]);
            sum[i] += a[i][j];
        }
    }
    for(int i = 0; i < n; i++) {
        printf("%d ", sum[i]);
    }
    return 0;
}
