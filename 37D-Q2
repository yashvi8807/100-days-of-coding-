//Q74: Find the transpose of a matrix.
#include <stdio.h>
int main() {
    int n, m;
    printf("Enter size of matrix n,m:");
    scanf("%d %d", &n, &m);
    int a[n][m];
    printf("Enter elements of matrix:");
    for(int i = 0; i < n; i++) {
        for(int j = 0; j < m; j++) {
            scanf("%d", &a[i][j]);
        }
    }
    for(int j = 0; j < m; j++) {
        for(int i = 0; i < n; i++) {
            printf("%d ", a[i][j]);
        }
        printf("\n");
    }
    return 0;
}

