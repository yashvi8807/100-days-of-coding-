//Q75: Add two matrices.
#include <stdio.h>
int main() {
    int n1, m1, n2, m2;
    printf("Enter size of matrix1:");
    scanf("%d %d", &n1, &m1);
    int a[n1][m1];
    printf("Enter elements of matrix1:");
    for(int i = 0; i < n1; i++){
        for(int j = 0; j < m1; j++)
            scanf("%d", &a[i][j]);}
    printf("Enter size of matrix2:");
    scanf("%d %d", &n2, &m2);
    int b[n2][m2];
    printf("Enter elements of matrix2:");
    for(int i = 0; i < n2; i++){
        for(int j = 0; j < m2; j++)
            scanf("%d", &b[i][j]);}
    if(n1 != n2 || m1 != m2) {
        printf("Matrix addition not possible");
        return 0;
    }
    int c[n1][m1];
    for(int i = 0; i < n1; i++) {
        for(int j = 0; j < m1; j++) {
            c[i][j] = a[i][j] + b[i][j];
        }
    }
    for(int i = 0; i < n1; i++) {
        for(int j = 0; j < m1; j++) {
            printf("%d ", c[i][j]);
        }
        printf("\n");
    }

    return 0;
}
