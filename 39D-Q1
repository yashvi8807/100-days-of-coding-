//Q77: Check if the elements on the diagonal of a matrix are distinct.
#include <stdio.h>
int main() {
    int n, m;
    printf("Enter size of matrix:");
    scanf("%d %d", &n, &m);
    int a[n][m];
    printf("Enter elements of matrix:");
    for(int i = 0; i < n; i++) {
        for(int j = 0; j < m; j++) {
            scanf("%d", &a[i][j]);
        }
    }
    int freq[1000] = {0}; 
    int isDistinct = 1;
    for(int i = 0; i < n && i < m; i++) {
        int val = a[i][i];
        freq[val]++;
        if(freq[val] > 1) {
            isDistinct = 0;
            break;
        }
    }
    if(isDistinct)
        printf("True");
    else
        printf("False");

    return 0;
}
