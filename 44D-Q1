//Q87: Count spaces, digits, and special characters in a string.
#include <stdio.h>
int main() {
    char str[100];
    int i = 0, spaces = 0, digits = 0, special = 0;
    printf("Enter string.");
    fgets(str, 100, stdin);  
    while (str[i] != '\0') {
        char ch = str[i];
        if (ch == ' ') {
            spaces++;
        }
        else if (ch >= '0' && ch <= '9') {
            digits++;
        }
        else if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z'))) {
            special++;
        }
        i++;
    }
    printf("Spaces=%d, Digits=%d, Special=%d", spaces, digits, special);
    return 0;
}
