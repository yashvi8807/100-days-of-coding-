//Q96: Reverse each word in a sentence without changing the word order.
#include <stdio.h>
#include <string.h>
int main() {
    char str[200];
    printf("Enter string.");
    fgets(str, 200, stdin);  
    int start = 0, i = 0;
    while (1) {
        if (str[i] == ' ' || str[i] == '\0' || str[i] == '\n') {
            int left = start;
            int right = i - 1;
            while (left < right) {
                char temp = str[left];
                str[left] = str[right];
                str[right] = temp;
                left++;
                right--;
            }
            if (str[i] == '\0' || str[i] == '\n')
                break;
            start = i + 1;  
        }
        i++;
    }
    printf("%s", str);
    return 0;
}
