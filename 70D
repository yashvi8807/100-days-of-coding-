//Q120: Write a program to take a string input. Change it to sentence case.
#include <stdio.h>
#include <ctype.h>  
int main() {
    char str[200];
    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);  
    int capitalize = 1; 
    for(int i = 0; str[i] != '\0'; i++) {
        if(isspace(str[i])) {
            capitalize = 1;
        } else if(capitalize && isalpha(str[i])) {
            str[i] = toupper(str[i]);
            capitalize = 0;
        } else {
            str[i] = str[i];  
        }
    }
    printf("Sentence case: %s\n", str);
    return 0;
}
